{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unify3d.ai/schemas/unify3d.mold/1",
  "title": "unify3d.mold/1 - compression mold design record and simulator manifest",
  "description": "mold.json in the folder '<mold file name>.mold' next to the mold part. Numbers are mm, deg, MPa, degC, kg, kN, cP, min unless the key names another unit (_g, _s, _Nm, _mm2, _mm3, _K, _um, Pct). Consumers ignore unknown keys; additive changes keep /1. The arrays mold_record merges by id (checks, simulations, stages, decisions, bodies, airTraps, vents, layout.cavities, partingLine.planes, hardware.bolts/dowels/fits/stops/tcWells, part.fragile/criticalFaces/drawing.tolerances) carry a string id. Written by: mold_record init (schema, id, tool, status, dates, units, files.moldPart, inputs, reserved material data), mold_calc (materials.part, process, shrink, layout, hardware, structural, checks), mold_part (part), mold_bodies (bodies), the agent (identity, scope, files.moldedPart, frame, part.drawing, part.criticalFaces, partingLine, airTraps, vents, process.pour plan, stages, decisions, bodies[].machining.notes, hardware.bom, setup, views, report, simulations), mold_record setup_sheet / machining_sheet (setupSheet, machiningSheet).",
  "type": "object",
  "required": [ "schema", "id", "tool", "status", "units" ],
  "properties": {
    "schema": { "const": "unify3d.mold/1" },
    "id": { "type": "string", "description": "GUID; also the part custom property Unify3D.MoldId. Checkpoints and the journal are keyed by it." },
    "tool": {
      "type": "object",
      "required": [ "name", "version" ],
      "properties": {
        "name": { "const": "design-compression-mold" },
        "version": { "type": "string" },
        "addin": { "type": "string" },
        "calculator": { "type": "string", "description": "MoldCalc.Version at init." }
      }
    },
    "status": { "enum": [ "planning", "sizing", "building", "verifying", "done" ] },
    "scope": { "enum": [ "build", "advisory" ], "description": "advisory: v1 plans but does not build this job (process class C, class B deeper than wide, landed-positive, or above 250 degC). An advisory job still ends with status done." },
    "createdAt": { "$ref": "#/$defs/time" },
    "updatedAt": { "$ref": "#/$defs/time" },
    "units": {
      "type": "object",
      "required": [ "length", "pressure" ],
      "properties": {
        "length": { "const": "mm" }, "angle": { "const": "deg" }, "pressure": { "const": "MPa" }, "temperature": { "const": "degC" },
        "mass": { "const": "kg" }, "force": { "const": "kN" }, "viscosity": { "const": "cP" }, "time": { "const": "min" },
        "display": { "enum": [ "imperial", "metric" ], "description": "Unit system of the mold document; reports print it first, SI in brackets." }
      }
    },
    "identity": {
      "type": "object",
      "description": "Written by the agent (Phase 0 and the G2 form). Both sheets print it.",
      "properties": {
        "moldNumber": { "type": "string" }, "revision": { "type": "string" }, "partNumber": { "type": "string" },
        "partName": { "type": "string" }, "customer": { "type": "string" }
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "moldPart": { "type": "string" },
        "moldedPart": {
          "type": [ "object", "null" ],
          "properties": {
            "path": { "type": "string" }, "converted": { "type": [ "string", "null" ] }, "feature": { "type": "string" },
            "fromDrawing": { "type": "boolean", "description": "Phase 1a: modelled by the agent from the drawing." },
            "sourceVolume_mm3": { "type": [ "number", "null" ] }
          }
        },
        "drawings": { "type": "array", "items": { "type": "object", "properties": { "path": { "type": "string" }, "pages": { "type": "integer" } } } }
      }
    },
    "inputs": {
      "type": "object",
      "description": "The page's values by input id, as mold_record init received them (numbers in SI-like units, choice labels, size arrays, selections, file lists, or {value, unit, display, si, notSet} objects). The agent merges answers it collected later (press meaning, lifting answers) here, because mold_calc reads them from here."
    },
    "materials": {
      "type": "object",
      "properties": {
        "part": {
          "type": "object",
          "properties": {
            "id": { "type": "string" }, "used": { "type": "object", "description": "The values the calculator used (page edits over the table)." },
            "confidence": { "type": "string" }, "sources": { "type": "array", "items": { "type": "string" } },
            "rheology": { "$ref": "#/$defs/reservedData", "description": "Viscosity vs time and temperature (for fill simulators)." },
            "kinetics": { "$ref": "#/$defs/reservedData", "description": "Gel time and cure kinetics." },
            "thermal": { "$ref": "#/$defs/reservedData", "description": "Conductivity, heat capacity, reaction heat of the part material." },
            "mechanical": { "$ref": "#/$defs/reservedData", "description": "Modulus or hardness vs temperature, friction and release (for demold simulators)." }
          }
        }
      }
    },
    "process": {
      "type": "object",
      "properties": {
        "class": { "enum": [ "A", "B", "C" ] },
        "processType": { "type": "string" },
        "processLabel": { "type": "string" },
        "builtByV1": { "type": "boolean" },
        "moldType": { "type": "string", "description": "flash_full_land | flash_stop_pads | semi_positive | landed_positive | positive" },
        "pour": {
          "type": [ "object", "null" ],
          "description": "side, tiltDeg and points are the agent's plan (Phase 2); the timing keys are mold_calc's (class A, D3); null for class B and C (no pour).",
          "properties": {
            "side": { "enum": [ "base", "lid", "both", "charge in base", "charge in lid" ] }, "tiltDeg": { "type": "number" },
            "points": { "type": "array", "items": { "type": "object", "properties": { "cavity": { "type": "string" }, "at": { "$ref": "#/$defs/vec3" } } } },
            "secondsPerCavity": { "type": "number" }, "secondsTotal": { "type": "number" }, "limitSeconds": { "type": [ "number", "null" ] },
            "massRate_g_s": { "type": "number" }, "handlingSeconds": { "type": "number" }
          }
        },
        "charge": {
          "type": "object",
          "properties": {
            "perCavity_g": { "type": "number" }, "shot_g": { "type": "number" }, "holdUpPct": { "type": "number" },
            "tolerancePct": { "type": "number" }, "excessPct": { "type": "number" }
          }
        },
        "overflowRequired_mm3": { "type": [ "number", "null" ] },
        "grooveRadius_mm": { "type": [ "number", "null" ] },
        "loadingWell": { "type": [ "object", "null" ] },
        "cureMin": { "type": "number" },
        "cureNote": { "type": "string", "description": "E6: class A datasheet demold time (+ a warning below moldTempC.min); class B halving per 10 degC within the material's range." },
        "postCure": {
          "type": [ "object", "null" ],
          "properties": { "required": { "type": "boolean" }, "tempC": { "type": [ "number", "null" ] }, "hours": { "type": [ "number", "null" ] }, "notes": { "type": [ "string", "null" ] } }
        },
        "press": {
          "type": "object",
          "properties": {
            "meaning": { "type": "string" }, "ramArea_mm2": { "type": "number" }, "force_kN": { "type": "number" },
            "aProj_mm2": { "type": "number" }, "aProjForce_mm2": { "type": "number" }, "pLC1_MPa": { "type": "number" }, "pLC1x_MPa": { "type": "number" },
            "pReq_MPa": { "type": "number" }, "fReq_kN": { "type": "number" }, "gaugeNeeded_MPa": { "type": "number" }, "gaugeForInput_MPa": { "type": "number" },
            "loadCentre_mm": { "$ref": "#/$defs/numArray" }
          }
        },
        "gauge": {
          "type": "object",
          "properties": {
            "recommended_MPa": { "type": "number" }, "max_MPa": { "type": [ "number", "null" ] }, "maxBasis": { "type": [ "string", "null" ] },
            "basis": { "type": "string" }, "unitShown": { "type": [ "string", "null" ], "description": "The unit the user's gauge reads in (psi, bar, MPa, kgf/cm2): the page's picked unit; the setup sheet's gauge filter prints in it. Null when not known." }
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "properties": {
        "origin": { "$ref": "#/$defs/vec3" }, "u": { "$ref": "#/$defs/vec3" }, "v": { "$ref": "#/$defs/vec3" }, "w": { "$ref": "#/$defs/vec3" },
        "coordinateSystem": { "type": "string", "description": "Feature name of MOLD CS (origin at the parting-plane centroid)." },
        "orient": { "type": "object", "description": "Transform applied to the molded part (axis-angle + move) so pull = +W." }
      }
    },
    "shrink": {
      "type": "object",
      "properties": {
        "pct": { "type": "number" }, "basis": { "type": "string" }, "basisLabel": { "type": "string" }, "effectivePct": { "type": "number" },
        "alphaRef": { "type": "number" }, "alphaCavity": { "type": "number" }, "deltaT_K": { "type": "number" },
        "scale": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "pctAxis": { "type": [ "object", "array", "null" ] }, "about": { "type": "string" }, "feature": { "type": "string" },
        "steelSafe": { "type": "array" }
      }
    },
    "part": {
      "type": "object",
      "properties": {
        "volume_mm3": { "type": "number" }, "area_mm2": { "type": "number" }, "box_mm": { "$ref": "#/$defs/numArray" },
        "projectedArea_mm2": { "type": "number" }, "perimeter_mm": { "type": "number" }, "mass_kg": { "type": "number" },
        "depthBase_mm": { "type": "number", "description": "Cavity depth in the base half: the chosen parting-line candidate's baseDepth_mm (the agent, Phase 2)." },
        "depthLid_mm": { "type": "number", "description": "Cavity depth in the lid half: the chosen candidate's lidDepth_mm (the agent, Phase 2)." },
        "plugHeight_mm": { "type": "number", "description": "Height of a lid plug, when the lid has one (the agent, Phase 2)." },
        "draft": { "type": "object" },
        "undercuts": { "$ref": "#/$defs/idArray" },
        "fragile": { "$ref": "#/$defs/idArray" },
        "criticalFaces": { "$ref": "#/$defs/idArray" },
        "drawing": {
          "type": "object",
          "properties": {
            "flashClass": { "type": [ "string", "null" ] }, "finish": { "type": [ "string", "null" ], "description": "Cavity finish (SPI or Ra); the machining sheet prints it." },
            "tolerances": {
              "type": "array",
              "items": {
                "type": "object", "required": [ "id" ],
                "properties": { "id": { "type": "string" }, "what": { "type": "string" }, "tol_mm": { "type": "number" }, "closure": { "type": "boolean" }, "sheet": { "type": "string" } }
              }
            },
            "notes": { "$ref": "#/$defs/idArray" },
            "keyDims": { "$ref": "#/$defs/idArray", "description": "Phase 1a: dimensions the user confirmed before the part was modelled." }
          }
        }
      }
    },
    "partingLine": {
      "type": "object",
      "properties": {
        "type": { "enum": [ "planar", "stepped", "none" ] },
        "planes": { "$ref": "#/$defs/idArray" },
        "candidates": { "$ref": "#/$defs/idArray" },
        "score": { "type": "number" }
      }
    },
    "airTraps": { "$ref": "#/$defs/idArray" },
    "vents": { "$ref": "#/$defs/idArray" },
    "layout": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string" }, "footprint_mm": { "$ref": "#/$defs/numArray" }, "moats": { "type": "string" },
        "cavities": {
          "type": "array",
          "items": { "type": "object", "required": [ "id" ], "properties": { "id": { "type": "string" }, "origin": { "$ref": "#/$defs/vec3" }, "rotationDeg": { "type": "number" } } }
        }
      }
    },
    "bodies": {
      "type": "array",
      "description": "Every solid body, from mold_bodies report (A2). The sheets list only machined roles.",
      "items": {
        "type": "object", "required": [ "id" ],
        "properties": {
          "id": { "type": "string", "description": "BASE-n, MID-n, LID-n, SUB-n, INS-<cavity>-n, STOP-n, PART-REF, GARBAGE-n, BODY-n (unfiled)" },
          "role": { "enum": [ "base", "middle", "lid", "subplate", "insert", "stop", "reference", "garbage", "unfiled" ] },
          "folder": { "type": [ "string", "null" ] }, "swName": { "type": [ "string", "null" ] }, "swMaterial": { "type": [ "string", "null" ] },
          "volume_mm3": { "type": "number" }, "mass_kg": { "type": [ "number", "null" ], "description": "null when no density is known (Garbage, reference bodies)." },
          "massBasis": { "type": "string" }, "box_mm": { "$ref": "#/$defs/numArray" }, "boxFrame_mm": { "$ref": "#/$defs/numArray" },
          "centroid": { "$ref": "#/$defs/vec3" }, "limits": { "type": "object" },
          "machining": {
            "type": "object",
            "description": "What only the agent knows about this piece, for the machining sheet: setups, pocket corner reliefs with the cutter, shut-off heights, finish per face group, engraving.",
            "properties": { "notes": { "$ref": "#/$defs/strings" } }
          }
        }
      }
    },
    "hardware": {
      "type": "object",
      "properties": {
        "bolts": {
          "type": "array",
          "items": {
            "type": "object", "required": [ "id" ],
            "properties": {
              "id": { "type": "string" }, "joint": { "type": "string" }, "size": { "type": "string" }, "spec": { "type": "string" },
              "count": { "type": "integer" }, "grip_mm": { "type": "number" }, "stockLength_mm": { "type": [ "number", "null" ] },
              "engagement_mm": { "type": "number" }, "tapDepth_mm": { "type": "number" },
              "preload_kN": { "type": "number" }, "preloadBand_kN": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "torqueDry_Nm": { "type": "number" }, "torqueLubed_Nm": { "type": "number" },
              "insert": { "type": [ "string", "null" ] }, "washer": { "type": [ "string", "null" ] },
              "cboreForWasher_mm": { "type": "number" }, "cboreDepth_mm": { "type": "number" }, "retorque": { "type": "string" }
            }
          }
        },
        "dowels": {
          "type": "array",
          "items": { "type": "object", "required": [ "id" ], "properties": { "id": { "type": "string" }, "d_mm": { "type": "number" }, "kind": { "type": "string" }, "at": { "$ref": "#/$defs/vec3" } } }
        },
        "dowelScheme": { "type": "object", "properties": { "scheme": { "type": "string" }, "mismatch_mm": { "type": "number" }, "lidBaseDeltaT_K": { "type": "number" } } },
        "fits": { "$ref": "#/$defs/idArray" },
        "stops": { "$ref": "#/$defs/idArray" },
        "tcWells": { "$ref": "#/$defs/idArray" },
        "lift": { "type": "array", "items": { "type": "object", "properties": { "body": { "type": "string" }, "kind": { "type": "string" } } } },
        "slideIn": { "type": [ "object", "null" ], "description": "mold_calc: locating stop, base pull handles, nothing proud below the base (E4)." },
        "bom": {
          "type": "array",
          "description": "Purchased items mold_calc doesn't size (bushings, jack screws, air poppets, shims, part numbers), written by the agent; the machining sheet lists them after the derived screws, washers, inserts and dowels.",
          "items": {
            "type": "object", "required": [ "item", "qty" ],
            "properties": {
              "id": { "type": "string" }, "item": { "type": "string" }, "size": { "type": "string" }, "qty": { "type": "integer" },
              "partNumber": { "type": [ "string", "null" ] }, "note": { "type": "string" }
            }
          }
        }
      }
    },
    "structural": {
      "type": "object",
      "properties": {
        "inputs": { "type": "object" },
        "materials": { "type": "object", "description": "plates and inserts: {id, tempC, E_GPa, Sy_MPa, Su_MPa, service, note}." },
        "loadCases": {
          "type": "object",
          "properties": {
            "LC1": {
              "type": "object",
              "properties": { "p_MPa": { "type": "number" }, "pressureField": { "$ref": "#/$defs/pressureField" } }
            },
            "LC1x": { "type": [ "object", "null" ], "description": "class A abuse case F/A_proj; null for class B and C" }, "LC2": { "type": "object" }, "LC3": { "type": "object" }, "LC4": { "type": "object" }, "LC5": { "type": "object" }
          }
        },
        "asBuilt": {
          "type": "object",
          "description": "Measured as built (the agent, stage 4.6 and Phase 5); mold_calc check reads it. Missing plate thicknesses and masses come from bodies[], everything else from the plan.",
          "properties": {
            "baseThickness_mm": { "type": "number" }, "lidThickness_mm": { "type": "number" }, "baseMass_kg": { "type": "number" }, "lidMass_kg": { "type": "number" },
            "walls": { "type": "object", "description": "Narrowest drawn steel per wall: the ids of structural.results.walls without the W- prefix (\"V-B\", \"U-B\", \"V-L\", \"U-L\"), mm.", "additionalProperties": { "type": "number" } },
            "bearingArea_mm2": { "type": "number", "description": "Bearing area measured on the faces that touch at closure (stage 4.6)." }
          }
        },
        "results": {
          "type": "object",
          "properties": {
            "pieces": { "$ref": "#/$defs/idArray" },
            "stackHeight_mm": { "type": "number" },
            "lid": {
              "type": "object",
              "description": "Lid weight against its limit (the user's max_lid_mass or the NIOSH limit) and the lifting index (A2).",
              "properties": { "mass_kg": { "type": "number" }, "limit_kg": { "type": "number" }, "limitBasis": { "type": "string" }, "liftingIndex": { "type": "number" } }
            },
            "partialLoading": {
              "type": "object",
              "description": "Running fewer cavities (E3): gauge and force per number of active cavities.",
              "properties": {
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "active": { "type": "integer" }, "gauge_MPa": { "type": "number" }, "force_kN": { "type": "number" },
                      "patterns": { "type": "integer" }, "of": { "type": [ "integer", "string" ], "description": "how many patterns there are, or a note when there are too many to list" }, "example": { "type": [ "string", "null" ] }, "note": { "type": "string" }
                    }
                  }
                },
                "neverFewerThan": { "type": "integer" }
              }
            }
          }
        },
        "coefficients": { "type": "object" }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object", "required": [ "id", "status" ],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string", "description": "mold_calc@<version>, agent, or <server>/<tool>@<version>." },
          "type": { "type": "string", "description": "deflection, stress, fatigue, bearing, boltSeparation, boltLoad, boltFatigue, stripping, fit, weight, box, interference, clearance, draft, undercut, criticalSurface, airTrap, machinability, fill, demold, cure, lifting, envelope, press, temperature, buckling, flashSystem, stage, ..." },
          "body": { "type": [ "string", "null" ] }, "loadCase": { "type": [ "string", "null" ] },
          "demand": { "type": [ "number", "null" ] }, "capacity": { "type": [ "number", "null" ] }, "unit": { "type": [ "string", "null" ] },
          "margin": { "type": [ "number", "null" ], "description": "capacity/demand - 1 for upper limits; demand/capacity - 1 for lower limits." },
          "status": { "enum": [ "pass", "warn", "fail", "not_run", "waived" ] },
          "method": { "type": "string" }, "stage": { "type": [ "string", "null" ] }, "note": { "type": [ "string", "null" ] },
          "waivedBy": { "type": [ "string", "null" ] }, "reason": { "type": [ "string", "null" ] },
          "location": { "$ref": "#/$defs/location" }
        }
      }
    },
    "simulations": {
      "type": "array",
      "items": {
        "type": "object", "required": [ "id", "hook", "status" ],
        "properties": {
          "id": { "type": "string" }, "hook": { "enum": [ "H1", "H2", "H3" ] }, "kind": { "enum": [ "process", "machinability", "structural" ] },
          "server": { "type": [ "string", "null" ] }, "tool": { "type": [ "string", "null" ] },
          "status": { "enum": [ "not_run", "running", "done", "failed" ] }, "reason": { "type": [ "string", "null" ] }, "jobId": { "type": [ "string", "null" ] },
          "requestedAt": { "type": [ "string", "null" ] }, "finishedAt": { "type": [ "string", "null" ] },
          "inputs": { "type": "object" }, "summary": { "type": [ "string", "null" ] },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
          "checks": { "type": "array", "items": { "type": "string" } },
          "overrides": { "type": "object" }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object", "required": [ "id" ],
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" }, "status": { "enum": [ "pending", "running", "in_progress", "done", "failed", "skipped" ] },
          "checkpoint": { "type": [ "string", "null" ], "description": "Exact checkpoint name (yyyyMMdd-HHmmss-<name>) to restore this stage's start." },
          "features": { "type": "array", "items": { "type": "string" } }, "check": { "type": "string" }, "at": { "$ref": "#/$defs/time" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object", "required": [ "id" ],
        "properties": {
          "id": { "type": "string" }, "at": { "$ref": "#/$defs/time" }, "topic": { "type": "string" }, "choice": {},
          "options": { "type": "array" }, "by": { "enum": [ "user", "agent", "default" ] }, "why": { "type": "string" }
        }
      }
    },
    "setup": {
      "type": "object",
      "description": "Operator text only the agent can write (lists print in order). Preheat, first-article, maintenance, slide-in and the numbers come from SetupSheet.Build.",
      "properties": {
        "assembly": { "$ref": "#/$defs/strings" }, "material": { "$ref": "#/$defs/strings" }, "pourSequence": { "$ref": "#/$defs/strings" },
        "demold": { "$ref": "#/$defs/strings" }, "release": { "type": "string" }, "cleaning": { "type": "string" }, "safety": { "$ref": "#/$defs/strings" }
      }
    },
    "views": {
      "type": "object",
      "properties": { "assembly": { "type": "string" }, "cavityMap": { "type": "string" } },
      "description": "Image files relative to the record folder."
    },
    "report": {
      "type": "object",
      "properties": {
        "lowestMargins": {
          "type": "array",
          "items": { "type": "object", "required": [ "id" ], "properties": { "id": { "type": "string" }, "type": { "type": [ "string", "null" ] }, "margin": { "type": [ "number", "null" ] }, "status": { "type": "string" } } }
        },
        "openItems": { "$ref": "#/$defs/strings" },
        "summary": { "type": "string" }
      }
    },
    "setupSheet": { "type": [ "string", "null" ] },
    "machiningSheet": { "type": [ "string", "null" ] }
  },
  "$defs": {
    "time": { "type": "string", "description": "ISO 8601 UTC, e.g. 2026-10-19T20:00:00Z" },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "numArray": { "type": "array", "items": { "type": "number" } },
    "strings": { "type": "array", "items": { "type": "string" } },
    "idArray": {
      "type": "array",
      "items": { "type": "object", "required": [ "id" ], "properties": { "id": { "type": "string" } } }
    },
    "reservedData": {
      "type": "object",
      "required": [ "status" ],
      "properties": {
        "status": { "enum": [ "unknown", "estimated", "measured", "datasheet" ] },
        "note": { "type": "string" },
        "source": { "type": [ "string", "null" ] },
        "data": { "description": "Free form until a simulator defines it (tables with units in their keys)." }
      }
    },
    "location": {
      "type": "object",
      "description": "Portable geometry reference a simulator can return (critique F1), in mold-frame mm. Map back with IModelDoc2.ClosestDistance or a short ray along -normal on the body with that id.",
      "required": [ "bodyId", "point", "normal" ],
      "properties": {
        "bodyId": { "type": "string", "description": "Record body id (BASE-1, PART-REF ...), matching exports/bodies/<bodyId>.step" },
        "point": { "$ref": "#/$defs/vec3" },
        "normal": { "$ref": "#/$defs/vec3" },
        "stepFaceId": { "type": [ "string", "null" ], "description": "Optional entity id of the face in that body's STEP file." }
      }
    },
    "finding": {
      "type": "object",
      "required": [ "id", "location" ],
      "properties": {
        "id": { "type": "string" }, "kind": { "type": "string" }, "severity": { "enum": [ "info", "warn", "fail" ] },
        "value": { "type": [ "number", "null" ] }, "unit": { "type": [ "string", "null" ] }, "text": { "type": "string" },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "pressureField": {
      "description": "Pressure from a process simulator for mold_calc check (H3, critique F3). Either (u,v,w,p) samples in the mold frame or per-face samples.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "required": [ "kind" ],
          "properties": {
            "kind": { "const": "uvwp" }, "file": { "type": "string", "description": "CSV relative to the record folder: u_mm,v_mm,w_mm,p_MPa" },
            "samples": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 } },
            "source": { "type": "string" }
          }
        },
        {
          "type": "object", "required": [ "kind" ],
          "properties": {
            "kind": { "const": "faceSamples" }, "file": { "type": "string", "description": "CSV: bodyId,x,y,z,nx,ny,nz,p_MPa" },
            "samples": {
              "type": "array",
              "items": {
                "type": "object", "required": [ "bodyId", "point", "normal", "p_MPa" ],
                "properties": { "bodyId": { "type": "string" }, "point": { "$ref": "#/$defs/vec3" }, "normal": { "$ref": "#/$defs/vec3" }, "p_MPa": { "type": "number" } }
              }
            },
            "source": { "type": "string" }
          }
        }
      ]
    }
  }
}
