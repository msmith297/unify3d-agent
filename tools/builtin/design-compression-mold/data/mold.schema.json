{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unify3d.ai/schemas/unify3d.mold/1",
  "title": "unify3d.mold/1 - compression mold design record and simulator manifest",
  "description": "mold.json in the folder '<mold file name>.mold' next to the mold part. Numbers are mm, deg, MPa, degC, kg, kN, cP, min unless the key names another unit (_g, _s, _Nm, _mm2, _mm3, _K, _um). Consumers ignore unknown keys; additive changes keep /1. Every array of objects has a string id; merges match on it.",
  "type": "object",
  "required": [ "schema", "id", "tool", "status", "units" ],
  "properties": {
    "schema": { "const": "unify3d.mold/1" },
    "id": { "type": "string", "description": "GUID; also the part custom property Unify3D.MoldId. Checkpoints and the journal are keyed by it." },
    "tool": {
      "type": "object",
      "required": [ "name", "version" ],
      "properties": {
        "name": { "const": "design-compression-mold" },
        "version": { "type": "string" },
        "addin": { "type": "string" },
        "calc": { "type": "string", "description": "MoldCalc.Version used for the latest results." }
      }
    },
    "status": { "enum": [ "planning", "sizing", "building", "verifying", "done" ] },
    "scope": { "enum": [ "build", "advisory" ], "description": "advisory: v1 plans but does not build this job (process class C, or class B deeper than wide)." },
    "createdAt": { "$ref": "#/$defs/time" },
    "updatedAt": { "$ref": "#/$defs/time" },
    "units": {
      "type": "object",
      "properties": {
        "length": { "const": "mm" }, "angle": { "const": "deg" }, "pressure": { "const": "MPa" }, "temperature": { "const": "degC" },
        "mass": { "const": "kg" }, "force": { "const": "kN" }, "viscosity": { "const": "cP" }, "time": { "const": "min" },
        "display": { "enum": [ "imperial", "metric" ], "description": "Unit system of the mold document; reports print it first, SI in brackets." }
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "moldNumber": { "type": "string" }, "revision": { "type": "string" }, "partNumber": { "type": "string" },
        "partName": { "type": "string" }, "customer": { "type": "string" }
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "moldPart": { "type": "string" },
        "moldedPart": {
          "type": "object",
          "properties": {
            "path": { "type": "string" }, "converted": { "type": [ "string", "null" ] }, "feature": { "type": "string" },
            "fromDrawing": { "type": "boolean", "description": "Phase 1a: modelled by the agent from the drawing." },
            "sourceVolume_mm3": { "type": "number" }
          }
        },
        "drawings": { "type": "array", "items": { "type": "object", "properties": { "path": { "type": "string" }, "pages": { "type": "integer" } } } }
      }
    },
    "inputs": {
      "type": "object",
      "description": "Page values keyed by input id: SI-like value plus what the user saw.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {}, "unit": { "type": "string" }, "display": { "type": "string" }, "table": {}, "edited": { "type": "boolean" }, "notSet": { "type": "boolean" }
        }
      }
    },
    "materials": {
      "type": "object",
      "properties": {
        "part": {
          "type": "object",
          "properties": {
            "id": { "type": "string" }, "name": { "type": "string" }, "processType": { "type": "string" },
            "used": { "type": "object" }, "confidence": { "type": "string" }, "sources": { "type": "array", "items": { "type": "string" } },
            "shrinkBasis": { "type": "string" }, "hazards": { "type": "string" },
            "rheology": { "$ref": "#/$defs/reservedData", "description": "Viscosity vs time and temperature (for fill simulators)." },
            "kinetics": { "$ref": "#/$defs/reservedData", "description": "Gel time and cure kinetics." },
            "thermal": { "$ref": "#/$defs/reservedData", "description": "Conductivity, heat capacity, reaction heat of the part material." },
            "mechanical": { "$ref": "#/$defs/reservedData", "description": "Modulus or hardness vs temperature, friction and release (for demold simulators)." }
          }
        },
        "plates": { "$ref": "#/$defs/gradeAtTemp" },
        "inserts": { "$ref": "#/$defs/gradeAtTemp" },
        "stops": { "$ref": "#/$defs/gradeAtTemp" }
      }
    },
    "process": {
      "type": "object",
      "properties": {
        "class": { "enum": [ "A", "B", "C" ] },
        "processType": { "type": "string" },
        "moldType": { "type": "string", "description": "flash_full_land | flash_stop_pads | semi_positive | landed_positive | positive" },
        "pressTempC": { "type": "number" },
        "pour": {
          "type": "object",
          "properties": {
            "side": { "enum": [ "base", "lid", "both", "charge" ] }, "tiltDeg": { "type": "number" },
            "time_s": { "type": "number" }, "rate_g_s": { "type": "number" }, "handling_s": { "type": "number" },
            "points": { "type": "array", "items": { "type": "object", "properties": { "cavity": { "type": "string" }, "at": { "$ref": "#/$defs/vec3" } } } }
          }
        },
        "charge": { "type": "object", "properties": { "perCavity_g": { "type": "number" }, "shot_g": { "type": "number" }, "tolerancePct": { "type": "number" }, "preform": { "type": "string" } } },
        "overflowRequired_mm3": { "type": "number" },
        "cureMin": { "type": "number" },
        "cureNote": { "type": "string", "description": "Class A: datasheet demold time (+ warning below moldTempC.min). Class B: halving per 10 degC within the material's range." },
        "postCure": { "type": [ "object", "null" ], "properties": { "tempC": { "type": "number" }, "hours": { "type": "number" }, "notes": { "type": "string" } } },
        "press": {
          "type": "object",
          "properties": {
            "ramArea_mm2": { "type": "number" }, "rated_kN": { "type": "number" }, "ratedGauge_MPa": { "type": "number" },
            "force_kN": { "type": "number" }, "required_kN": { "type": "number" }, "platen_mm": { "$ref": "#/$defs/numArray" },
            "daylight_mm": { "type": [ "number", "null" ] }, "stroke_mm": { "type": [ "number", "null" ] }
          }
        },
        "gauge": {
          "type": "object",
          "properties": {
            "recommended_MPa": { "type": "number" }, "max_MPa": { "type": "number" }, "maxBasis": { "type": "string" },
            "basis": { "type": "string" }, "conversion": { "type": "string" }, "unitShown": { "type": "string" }
          }
        },
        "closedHeight_mm": { "type": "number" },
        "loadCentre": { "type": "string" },
        "minActiveCavities": { "type": "integer" },
        "partialLoading": {
          "type": "array",
          "description": "Setup-sheet table: gauge per number of active cavities (critique E3).",
          "items": {
            "type": "object", "required": [ "id" ],
            "properties": {
              "id": { "type": "string" }, "active": { "type": "integer" }, "pattern": { "type": "string" },
              "gauge_MPa": { "type": "number" }, "pressureOnPart_MPa": { "type": "number" }, "allowed": { "type": "boolean" }, "note": { "type": "string" }
            }
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "properties": {
        "origin": { "$ref": "#/$defs/vec3" }, "u": { "$ref": "#/$defs/vec3" }, "v": { "$ref": "#/$defs/vec3" }, "w": { "$ref": "#/$defs/vec3" },
        "coordinateSystem": { "type": "string", "description": "Feature name of MOLD CS (origin at the parting-plane centroid)." },
        "orient": { "type": "object", "description": "Transform applied to the molded part (axis-angle + move) so pull = +W." }
      }
    },
    "shrink": {
      "type": "object",
      "properties": {
        "pct": { "type": "number" }, "basis": { "type": "string" }, "formula": { "type": "string" },
        "alphaRef": { "type": "number" }, "alphaCavity": { "type": "number" }, "deltaT_K": { "type": "number" },
        "scale": { "$ref": "#/$defs/numArray" }, "about": { "type": "string" }, "feature": { "type": "string" }
      }
    },
    "part": {
      "type": "object",
      "properties": {
        "volume_mm3": { "type": "number" }, "area_mm2": { "type": "number" }, "box_mm": { "$ref": "#/$defs/numArray" },
        "projectedArea_mm2": { "type": "number" }, "perimeter_mm": { "type": "number" }, "mass_kg": { "type": "number" },
        "draft": { "type": "object" },
        "undercuts": { "$ref": "#/$defs/idArray" },
        "fragile": { "$ref": "#/$defs/idArray" },
        "criticalFaces": { "$ref": "#/$defs/idArray" },
        "drawing": {
          "type": "object",
          "properties": {
            "flashClass": { "type": [ "string", "null" ] }, "finish": { "type": [ "string", "null" ] },
            "tolerances": { "$ref": "#/$defs/idArray" }, "notes": { "$ref": "#/$defs/idArray" },
            "keyDims": { "$ref": "#/$defs/idArray", "description": "Phase 1a: dimensions the user confirmed before the part was modelled." }
          }
        }
      }
    },
    "partingLine": {
      "type": "object",
      "properties": {
        "type": { "enum": [ "planar", "stepped", "none" ] },
        "planes": { "$ref": "#/$defs/idArray" },
        "candidates": { "$ref": "#/$defs/idArray" },
        "score": { "type": "number" }
      }
    },
    "airTraps": { "$ref": "#/$defs/idArray" },
    "vents": { "$ref": "#/$defs/idArray" },
    "layout": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string" }, "footprint_mm": { "$ref": "#/$defs/numArray" },
        "cavities": { "$ref": "#/$defs/idArray" }, "moats": { "type": "string" }
      }
    },
    "bodies": {
      "type": "array",
      "items": {
        "type": "object", "required": [ "id" ],
        "properties": {
          "id": { "type": "string", "description": "BASE-n, MID-n, LID-n, SUB-n, INS-<cavity>-n, STOP-n, PART-REF" },
          "role": { "enum": [ "base", "middle", "lid", "subplate", "insert", "stop", "reference" ] },
          "folder": { "type": "string" }, "createdBy": { "type": "string" }, "swName": { "type": "string" },
          "material": { "type": "string" }, "materialName": { "type": "string" }, "swMaterial": { "type": [ "string", "null" ] },
          "volume_mm3": { "type": "number" }, "mass_kg": { "type": "number" }, "box_mm": { "$ref": "#/$defs/numArray" },
          "centroid": { "$ref": "#/$defs/vec3" }, "limits": { "type": "object" }, "cavities": { "type": "array", "items": { "type": "string" } },
          "lift": { "type": "string", "description": "one person (2 handles) | two people | hoist (2 x M12 hoist rings) ..." },
          "machining": { "$ref": "#/$defs/machining" },
          "step": { "type": "string" }
        }
      }
    },
    "hardware": {
      "type": "object",
      "properties": {
        "bolts": {
          "type": "array",
          "items": {
            "type": "object", "required": [ "id" ],
            "properties": {
              "id": { "type": "string" }, "joint": { "type": "string" }, "size": { "type": "string" }, "spec": { "type": "string" },
              "count": { "type": "integer" }, "length": { "type": "string" }, "grip_mm": { "type": "number" },
              "preload_kN": { "type": "number" }, "preloadMin_kN": { "type": "number" }, "preloadMax_kN": { "type": "number" },
              "torqueDry_Nm": { "type": "number" }, "torqueLubed_Nm": { "type": "number" },
              "insert": { "type": [ "string", "null" ] }, "washer": { "type": [ "string", "null" ] }, "cbore": { "type": "string" }
            }
          }
        },
        "dowels": { "$ref": "#/$defs/idArray" },
        "fits": { "$ref": "#/$defs/idArray" },
        "stops": { "$ref": "#/$defs/idArray" },
        "tcWells": { "$ref": "#/$defs/idArray" },
        "jackScrews": { "$ref": "#/$defs/idArray" },
        "lift": { "type": "array", "items": { "type": "object" } },
        "bom": {
          "type": "array",
          "description": "Purchased hardware (critique E2).",
          "items": {
            "type": "object", "required": [ "id" ],
            "properties": {
              "id": { "type": "string" }, "item": { "type": "string" }, "spec": { "type": "string" }, "size": { "type": "string" },
              "length": { "type": "string" }, "qty": { "type": "integer" }, "partNumber": { "type": [ "string", "null" ] },
              "use": { "type": "string" }, "note": { "type": "string" }
            }
          }
        }
      }
    },
    "handling": {
      "type": "object",
      "properties": {
        "lid": {
          "type": "object",
          "properties": {
            "mass_kg": { "type": "number" }, "limit_kg": { "type": "number" }, "limitSource": { "type": "string" },
            "rwl_kg": { "type": [ "number", "null" ] }, "liftingIndex": { "type": [ "number", "null" ] },
            "where": { "type": "string" }, "reach_mm": { "type": "number" }, "liftsPerHour": { "type": "number" }, "method": { "type": "string" }
          }
        },
        "slideIn": { "type": "array", "items": { "type": "string" } }
      }
    },
    "structural": {
      "type": "object",
      "properties": {
        "inputs": { "type": "object" },
        "loadCases": {
          "type": "object",
          "properties": {
            "LC1": {
              "type": "object",
              "properties": { "p_MPa": { "type": "number" }, "pressureField": { "$ref": "#/$defs/pressureField" } }
            },
            "LC1x": { "type": "object" }, "LC2": { "type": "object" }, "LC3": { "type": "object" }, "LC4": { "type": "object" }, "LC5": { "type": "object" }
          }
        },
        "results": { "type": "object" },
        "coefficients": { "type": "object" }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object", "required": [ "id", "status" ],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string", "description": "mold_calc@<version>, agent, or <server>/<tool>@<version>." },
          "type": { "type": "string", "description": "deflection, stress, fatigue, bearing, boltSeparation, boltLoad, boltFatigue, stripping, fit, weight, box, interference, clearance, draft, undercut, criticalSurface, airTrap, machinability, fill, demold, cure, lifting, envelope, press, temperature, buckling, flashSystem, stage, ..." },
          "body": { "type": [ "string", "null" ] }, "loadCase": { "type": [ "string", "null" ] },
          "demand": { "type": [ "number", "null" ] }, "capacity": { "type": [ "number", "null" ] }, "unit": { "type": [ "string", "null" ] },
          "margin": { "type": [ "number", "null" ], "description": "capacity/demand - 1 for upper limits; demand/capacity - 1 for lower limits." },
          "status": { "enum": [ "pass", "warn", "fail", "not_run", "waived" ] },
          "method": { "type": "string" }, "stage": { "type": "string" }, "note": { "type": "string" },
          "waivedBy": { "type": [ "string", "null" ] }, "reason": { "type": [ "string", "null" ] },
          "location": { "$ref": "#/$defs/location" }
        }
      }
    },
    "simulations": {
      "type": "array",
      "items": {
        "type": "object", "required": [ "id", "hook", "status" ],
        "properties": {
          "id": { "type": "string" }, "hook": { "enum": [ "H1", "H2", "H3" ] }, "kind": { "enum": [ "process", "machinability", "structural" ] },
          "server": { "type": [ "string", "null" ] }, "tool": { "type": [ "string", "null" ] },
          "status": { "enum": [ "not_run", "running", "done", "failed" ] }, "reason": { "type": [ "string", "null" ] }, "jobId": { "type": [ "string", "null" ] },
          "requestedAt": { "type": [ "string", "null" ] }, "finishedAt": { "type": [ "string", "null" ] },
          "inputs": { "type": "object" }, "summary": { "type": [ "string", "null" ] },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
          "checks": { "type": "array", "items": { "type": "string" } },
          "overrides": { "type": "object" }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object", "required": [ "id" ],
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" }, "status": { "enum": [ "pending", "running", "done", "failed", "skipped" ] },
          "checkpoint": { "type": [ "string", "null" ], "description": "Exact checkpoint name (yyyyMMdd-HHmmss-<name>) to restore this stage's start." },
          "features": { "type": "array", "items": { "type": "string" } }, "check": { "type": "string" }, "at": { "$ref": "#/$defs/time" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object", "required": [ "id" ],
        "properties": {
          "id": { "type": "string" }, "at": { "$ref": "#/$defs/time" }, "topic": { "type": "string" }, "choice": {},
          "options": { "type": "array" }, "by": { "enum": [ "user", "agent", "default" ] }, "why": { "type": "string" }
        }
      }
    },
    "setup": {
      "type": "object",
      "description": "Operator text the agent writes for the setup sheet (lists are printed in order).",
      "properties": {
        "assembly": { "$ref": "#/$defs/strings" }, "preheat": { "type": "string" }, "material": { "$ref": "#/$defs/strings" },
        "pourSequence": { "$ref": "#/$defs/strings" }, "demold": { "$ref": "#/$defs/strings" }, "release": { "type": "string" },
        "cleaning": { "type": "string" }, "firstArticle": { "$ref": "#/$defs/strings" }, "safety": { "$ref": "#/$defs/strings" },
        "maintenance": { "$ref": "#/$defs/strings" }
      }
    },
    "views": {
      "type": "object",
      "properties": { "assembly": { "type": "string" }, "cavityMap": { "type": "string" } },
      "description": "Image files relative to the record folder."
    },
    "report": {
      "type": "object",
      "properties": {
        "lowestMargins": { "$ref": "#/$defs/idArray" },
        "openItems": { "$ref": "#/$defs/strings" },
        "summary": { "type": "string" }
      }
    },
    "setupSheet": { "type": [ "string", "null" ] },
    "machiningSheet": { "type": [ "string", "null" ] }
  },
  "$defs": {
    "time": { "type": "string", "description": "ISO 8601 UTC, e.g. 2026-10-19T20:00:00Z" },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "numArray": { "type": "array", "items": { "type": "number" } },
    "strings": { "type": "array", "items": { "type": "string" } },
    "idArray": {
      "type": "array",
      "items": { "type": "object", "required": [ "id" ], "properties": { "id": { "type": "string" } } }
    },
    "gradeAtTemp": {
      "type": "object",
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" },
        "atTemp": {
          "type": "object",
          "properties": {
            "tempC": { "type": "number" }, "E_GPa": { "type": "number" }, "Sy_MPa": { "type": "number" }, "Su_MPa": { "type": "number" },
            "service": { "type": "string", "description": "ok | ok-derated | limited | not allowed | no data (S12)" }
          }
        }
      }
    },
    "reservedData": {
      "type": "object",
      "required": [ "status" ],
      "properties": {
        "status": { "enum": [ "unknown", "estimated", "measured", "datasheet" ] },
        "source": { "type": [ "string", "null" ] },
        "data": { "description": "Free form until a simulator defines it (tables with units in their keys)." }
      }
    },
    "location": {
      "type": "object",
      "description": "Portable geometry reference a simulator can return (critique F1). Map back with IModelDoc2.ClosestDistance or a ray along -normal.",
      "required": [ "bodyId", "point" ],
      "properties": {
        "bodyId": { "type": "string", "description": "Record body id (BASE-1, PART-REF ...), matching exports/bodies/<bodyId>.step" },
        "point": { "$ref": "#/$defs/vec3" },
        "normal": { "$ref": "#/$defs/vec3" },
        "stepFaceId": { "type": [ "string", "null" ], "description": "Optional entity id of the face in that body's STEP file." }
      }
    },
    "finding": {
      "type": "object",
      "required": [ "id", "location" ],
      "properties": {
        "id": { "type": "string" }, "kind": { "type": "string" }, "severity": { "enum": [ "info", "warn", "fail" ] },
        "value": { "type": [ "number", "null" ] }, "unit": { "type": [ "string", "null" ] }, "text": { "type": "string" },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "pressureField": {
      "description": "Pressure from a process simulator for mold_calc check (H3, critique F3). Either (u,v,w,p) samples in the mold frame or per-face samples.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "required": [ "kind" ],
          "properties": {
            "kind": { "const": "uvwp" }, "file": { "type": "string", "description": "CSV relative to the record folder: u_mm,v_mm,w_mm,p_MPa" },
            "samples": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 } },
            "source": { "type": "string" }
          }
        },
        {
          "type": "object", "required": [ "kind" ],
          "properties": {
            "kind": { "const": "faceSamples" }, "file": { "type": "string", "description": "CSV: bodyId,x,y,z,nx,ny,nz,p_MPa" },
            "samples": {
              "type": "array",
              "items": {
                "type": "object", "required": [ "bodyId", "point", "p_MPa" ],
                "properties": { "bodyId": { "type": "string" }, "point": { "$ref": "#/$defs/vec3" }, "normal": { "$ref": "#/$defs/vec3" }, "p_MPa": { "type": "number" } }
              }
            },
            "source": { "type": "string" }
          }
        }
      ]
    },
    "machining": {
      "type": "object",
      "description": "Per-body machining sheet data (critique E1).",
      "properties": {
        "stock": {
          "type": "object",
          "properties": {
            "grade": { "type": "string" }, "finished_mm": { "$ref": "#/$defs/numArray" }, "blank_mm": { "$ref": "#/$defs/numArray" },
            "stockThickness": { "type": "string" }, "allowance": { "type": "string" }
          }
        },
        "setups": { "type": "array", "items": { "$ref": "#/$defs/vec3" } },
        "setupsText": { "type": "string" },
        "minInsideRadius_mm": { "type": "number" }, "maxDepth_mm": { "type": "number" },
        "holes": {
          "type": "array",
          "items": {
            "type": "object", "required": [ "id" ],
