[
  { "Id": "mold_material", "Type": "options", "Label": "Mold material", "Group": "1 Cascade", "Remember": true,
    "Tip": "Parent of the grade list below (options can be parents too).",
    "Choices": [ "Aluminium + steel inserts", "Tool steel" ], "Default": "Aluminium + steel inserts" },
  { "Id": "mold_grade", "Type": "choice", "Label": "Plate grade", "Group": "1 Cascade", "Remember": true,
    "Tip": "Entries from data/grades.json filtered by the mold material (ValueMap) and use = plate (array containment).",
    "ChoicesFrom": "data/grades.json#grades", "ChoiceKey": "short", "DependsOn": "mold_material",
    "RowFilter": { "family": "{mold_material}", "use": "plate" },
    "ValueMap": { "Aluminium + steel inserts": "aluminium", "Tool steel": "steel" } },
  { "Id": "insert_grade", "Type": "choice", "Label": "Insert grade", "Group": "1 Cascade", "Remember": true,
    "Tip": "Shown only for the aluminium option (ShowWhen).",
    "ChoicesFrom": "data/grades.json#grades", "ChoiceKey": "short",
    "RowFilter": { "family": "steel", "use": "insert" },
    "ShowWhen": { "mold_material": [ "Aluminium + steel inserts" ] } },
  { "Id": "grade_info", "Type": "info", "Group": "1 Cascade",
    "Text": "Full strength to {mold_grade.max_service_C.full_strength|temperature}, derated to {mold_grade.max_service_C.derated|temperature}" },

  { "Id": "part_family", "Type": "choice", "Label": "Part material", "Group": "2 Material", "Remember": true,
    "ChoicesFrom": "data/materials.json#rows", "ChoiceKey": "familyLabel", "Default": "Cast PU - TDI polyether" },
  { "Id": "part_grade", "Type": "choice", "Label": "Grade", "Group": "2 Material", "Remember": true,
    "Tip": "Picking a grade fills the Process data group; rubber grades hide viscosity and pot life (null in the data).",
    "ChoicesFrom": "data/materials.json#rows", "ChoiceKey": "name", "DependsOn": "part_family",
    "RowFilter": { "familyLabel": "{part_family}" }, "Default": "TDI-polyether / MBOCA 90A",
    "Fills": { "shrink_pct": "shrinkPct.typ", "sg": "sg.typ", "viscosity_cp": "viscosityCp.typ", "mooney": "mooney.typ",
               "pot_life_min": "potLifeMin.typ", "cure_min": "demoldMin.typ", "draft_min_deg": "draftDeg.min", "press_temp": "moldTempC.typ",
               "molding_pressure": "moldingPressurePsi.typ|psi" } },
  { "Id": "material_info", "Type": "info", "Group": "2 Material",
    "Text": "{part_grade.processLabel} - data confidence {part_grade.confidence}; molding {part_grade.moldingPressurePsi.typ|psi}" },

  { "Id": "shrink_pct", "Type": "number", "Unit": "percent", "Label": "Shrinkage (%)", "Group": "3 Process data (from table)", "GroupExpanded": false,
    "Remember": true, "Min": 0, "Max": 10, "Default": "1.5" },
  { "Id": "sg", "Type": "number", "Unit": "none", "Label": "Specific gravity", "Group": "3 Process data (from table)", "Remember": true,
    "Min": 0.1, "Max": 5, "Default": "1.10" },
  { "Id": "viscosity_cp", "Type": "number", "Unit": "viscosity", "Label": "Mixed viscosity", "Group": "3 Process data (from table)", "Remember": true,
    "Min": 1, "Max": 10000000, "Default": "1200" },
  { "Id": "mooney", "Type": "number", "Unit": "none", "Label": "Mooney viscosity", "Group": "3 Process data (from table)", "Remember": true,
    "Min": 1, "Max": 200, "Default": "45" },
  { "Id": "pot_life_min", "Type": "number", "Unit": "time", "Label": "Pot life", "Group": "3 Process data (from table)", "Remember": true,
    "Min": 0, "Max": 1440, "Default": "6" },
  { "Id": "cure_min", "Type": "number", "Unit": "time", "Label": "Cure / demold time", "Group": "3 Process data (from table)", "Remember": true,
    "Min": 0, "Max": 1440, "Default": "30" },
  { "Id": "draft_min_deg", "Type": "number", "Unit": "angle", "Label": "Minimum draft", "Group": "3 Process data (from table)", "Remember": true,
    "Min": 0, "Max": 10, "Default": "0.5" },
  { "Id": "molding_pressure", "Type": "number", "Unit": "pressure", "Label": "Molding pressure (on the part)", "Group": "3 Process data (from table)",
    "Tip": "Filled from data stored in psi (Fills \"moldingPressurePsi.typ|psi\").", "Min": 0, "Max": 150, "Default": "0.345" },

  { "Id": "press_pressure", "Type": "number", "Unit": "pressure", "Label": "Press pressure", "Group": "4 Press", "Remember": true,
    "Tip": "UnitChoices: pick the unit your gauge reads; it is remembered.", "UnitChoices": [ "psi", "bar", "MPa", "kgf/cm2" ],
    "Min": 0.01, "Max": 100, "Default": "13.79" },
  { "Id": "press_pressure_is", "Type": "choice", "Label": "Press pressure is", "Group": "4 Press", "Remember": true,
    "Choices": [ "Gauge reading", "On the part", "Force reading (tons)", "Not sure - ask me" ], "Default": "Not sure - ask me" },
  { "Id": "press_temp", "Type": "number", "Unit": "temperature", "Label": "Press temperature", "Group": "4 Press",
    "Tip": "Filled from the material, not remembered.", "Min": 0, "Max": 250, "Default": "100" },
  { "Id": "press_rated_force", "Type": "number", "Unit": "tonnage", "Label": "Press rated force", "Group": "4 Press", "Remember": true,
    "UnitChoices": [ "US ton", "t", "kN" ], "Min": 1, "Max": 50000, "Default": "444.8" },
  { "Id": "press_rated_gauge", "Type": "number", "Unit": "pressure", "Label": "Gauge at rated force", "Group": "4 Press", "Remember": true,
    "Tip": "Shown only for gauge readings or 'not sure' (ShowWhen).", "UnitChoices": [ "psi", "bar", "MPa", "kgf/cm2" ],
    "Min": 0.1, "Max": 100, "Default": "20.68", "ShowWhen": { "press_pressure_is": [ "Gauge reading", "Not sure - ask me" ] } },

  { "Id": "platen_size", "Type": "size", "Dims": 2, "Label": "Heated platen size", "Group": "5 Limits", "Remember": true,
    "Optional": true, "Enabled": false, "Min": 50, "Max": 5000, "Default": "610,610" },
  { "Id": "daylight", "Type": "number", "Unit": "length", "Label": "Daylight", "Group": "5 Limits", "Remember": true,
    "Optional": true, "Enabled": false, "Min": 10, "Max": 3000, "Default": "300" },
  { "Id": "max_plate_mass", "Type": "number", "Unit": "mass", "Label": "Max weight per plate", "Group": "5 Limits", "Remember": true,
    "Optional": true, "Enabled": true, "Min": 1, "Max": 5000, "Default": "23" },
  { "Id": "max_plate_size", "Type": "size", "Dims": 3, "Label": "Max size per plate", "Group": "5 Limits", "Remember": true,
    "Optional": true, "Enabled": true, "Min": 10, "Max": 5000, "Default": "600,400,150" },
  { "Id": "clamp_force", "Type": "number", "Unit": "force", "Label": "Clamp force", "Group": "5 Limits", "Min": 0, "Max": 10000, "Default": "50" },

  { "Id": "cavities", "Type": "integer", "Label": "Number of cavities", "Group": "6 Counts", "Min": 1, "Max": 64, "Default": "1" },
  { "Id": "cycle_life", "Type": "integer", "Label": "Cycle life (parts per cavity)", "Group": "6 Counts", "Remember": true,
    "Min": 1, "Max": 10000000, "Default": "5000" },

  { "Id": "show_extra", "Type": "checkbox", "Label": "Show the extra note", "Group": "7 Checkbox parent", "Remember": true, "Default": "false" },
  { "Id": "extra_note", "Type": "text", "Label": "Extra note", "Group": "7 Checkbox parent", "Required": false,
    "ShowWhen": { "show_extra": [ "true" ] } },

  { "Id": "faces", "Type": "selection", "Label": "Faces (optional)", "Group": "8 Selection", "Filter": [ "face" ], "Required": false },

  { "Id": "drawing", "Type": "files", "Label": "Engineering drawing", "Group": "9 Files", "Accept": [ "pdf", "image", "drawing" ],
    "Multiple": true, "Required": false },

  { "Id": "must_set", "Type": "number", "Unit": "mass", "Label": "Required limit (switch on)", "Group": "10 Required", "Optional": true, "Enabled": false,
    "Required": true, "Min": 1, "Max": 100, "Default": "10",
    "Tip": "OK stays disabled until this is switched on: a bubble says why." },

  { "Id": "legacy_len", "Type": "number", "Label": "Legacy length", "Group": "11 Original options", "Default": "12.5", "Icon": "depth" },
  { "Id": "legacy_angle", "Type": "number", "Unit": "angle", "Label": "Legacy angle", "Group": "11 Original options", "Default": "5" },
  { "Id": "legacy_plain", "Type": "number", "Unit": "none", "Label": "Legacy plain number", "Group": "11 Original options", "Default": "3.25" },
  { "Id": "legacy_choice", "Type": "choice", "Label": "Legacy choice", "Group": "11 Original options", "Choices": [ "Red", "Green", "Blue" ], "Default": "Green" },
  { "Id": "legacy_flag", "Type": "checkbox", "Label": "Legacy checkbox", "Group": "11 Original options", "Default": "true" },

  { "Id": "decisions", "Type": "options", "Label": "Big decisions", "Group": "12 Decisions & notes", "GroupExpanded": false, "Remember": true,
    "Choices": [ "Ask on big ones", "Ask about all", "Decide everything" ], "Default": "Ask on big ones" },
  { "Id": "notes", "Type": "text", "Label": "Notes", "Group": "12 Decisions & notes", "Required": false }
]
