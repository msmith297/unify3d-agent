<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-only sweep console for the compression-mold structural method (not shipped). Writes coefficients.csv and the files in
       tools/builtin/design-compression-mold/data/validation. Run from the repository root, Release build (see README.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\SwAgent\SwAgent.csproj" />
  </ItemGroup>

</Project>
