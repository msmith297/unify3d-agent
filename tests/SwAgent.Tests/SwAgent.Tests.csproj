<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless tests for the parts of the add-in that don't need SolidWorks: mesh reading, measuring and rendering
       (3D model context) and the "Watch me" diff / activity log. Run with scripts/test.ps1 or `dotnet test tests/SwAgent.Tests`. -->
  <PropertyGroup>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/test.runsettings</RunSettingsFilePath>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Test only: validates mold records against tools/builtin/design-compression-mold/data/mold.schema.json (draft 2020-12). -->
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>

  <!-- Plugin fixtures (real agent-bridge manifests, read only) next to the test dll: Plugins\Fixtures\... -->
  <ItemGroup>
    <Compile Remove="Plugins\Fixtures\**" />
    <None Include="Plugins\Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Fake plugin programs (a stdio MCP server, hook scripts) for the plugin runtime tests; they need node, else those tests skip. -->
  <ItemGroup>
    <None Include="..\fixtures\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SwAgent\SwAgent.csproj" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Speech" />
  </ItemGroup>

</Project>
