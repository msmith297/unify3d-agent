<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless tests for the parts of the add-in that don't need SolidWorks: mesh reading, measuring and rendering
       (3D model context) and the "Watch me" diff / activity log. Run with scripts/test.ps1 or `dotnet test tests/SwAgent.Tests`. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SwAgent\SwAgent.csproj" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

</Project>
